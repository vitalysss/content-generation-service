APP_ENV=local
APP_LOG_LEVEL=INFO
LOG_DIRECTORY=logs
LOG_RETENTION_DAYS=7
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/content_service
REDIS_URL=redis://redis:6379/0
FAL_KEY=
GENERATION_PROVIDER=fake
FALLBACK_GENERATION_PROVIDER=fake
CALLBACK_TIMEOUT_SECONDS=10
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BLOCK_SECONDS=60
FAL_QUEUE_BASE_URL=https://queue.fal.run
FAL_POLL_INTERVAL_SECONDS=2
FAL_REQUEST_TIMEOUT_SECONDS=300
PROCESSING_LEASE_SECONDS=600
QUEUED_RECOVERY_SECONDS=120
CALLBACK_DELIVERY_LEASE_SECONDS=60
PAYMENT_WEBHOOK_SECRET=change-me
API_KEY_PEPPER=change-me
COST_TEXT_TO_IMAGE=10
COST_IMAGE_TO_IMAGE=15
COST_TEXT_TO_VIDEO=50
COST_IMAGE_TO_VIDEO=60
VIDEO_RESOLUTION_480P_PERCENT=50
